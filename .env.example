# Supabase (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://ofarxltreyfpxsbiafzs.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Web Push (VAPID)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# URL pública de la app (para logos en correos de ticket)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# FacturemosYa (CFDI)
FACTUREMOSYA_URL=https://www.facturemosya.com/webservice/timbrarCfdi4_0.php
FACTUREMOSYA_USUARIO=
FACTUREMOSYA_PASSWORD=
FACTUREMOSYA_REGIMEN_EMISOR=601
FACTUREMOSYA_CP_EXPEDICION=06010
FACTUREMOSYA_SERIE=

# Sobrescrituras opcionales para FRAMEX (si usa credenciales distintas)
# FACTUREMOSYA_URL_FRX=
# FACTUREMOSYA_USUARIO_FRX=
# FACTUREMOSYA_PASSWORD_FRX=
# FACTUREMOSYA_REGIMEN_EMISOR_FRX=601
# FACTUREMOSYA_CP_EXPEDICION_FRX=06010
# FACTUREMOSYA_SERIE_FRX=FRX
# FACTUREMOSYA_CANCELACION_URL_FRX=

# Resend (envío de facturas por correo)
RESEND_API_KEY=
RESEND_FROM_EMAIL=facturacion@tu-dominio.com
RESEND_WEBHOOK_SECRET=
CONTADOR_EMAIL=contador@tu-dominio.com

# Facturación CFDI (false = stand-by)
NEXT_PUBLIC_FACTURACION_HABILITADA=false
